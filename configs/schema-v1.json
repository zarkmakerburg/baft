{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baft.invalid/schema/config-v1.json",
  "title": "BAFT configuration schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node", "tls", "transport", "limits", "recovery", "routes", "management", "logging"],
  "properties": {
    "schema_version": {"const": 1},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "role": {"enum": ["dialer", "listener"]}
      }
    },
    "peer": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "server_name", "allowed_identity"],
      "properties": {
        "address": {"type": "string", "minLength": 3},
        "server_name": {"type": "string", "minLength": 1},
        "allowed_identity": {"type": "string", "minLength": 1}
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["listen", "server_name", "allowed_peer_identities"],
      "properties": {
        "listen": {"type": "string", "minLength": 3},
        "server_name": {"type": "string", "minLength": 1},
        "allowed_peer_identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["min_version", "ca_file", "cert_file", "key_file", "session_tickets"],
      "properties": {
        "min_version": {"const": "1.3"},
        "ca_file": {"type": "string", "minLength": 1},
        "cert_file": {"type": "string", "minLength": 1},
        "key_file": {"type": "string", "minLength": 1},
        "session_tickets": {"const": false}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "h3_enabled", "shards", "profile"],
      "properties": {
        "primary": {"const": "h2"},
        "h3_enabled": {"const": false},
        "shards": {"type": "integer", "minimum": 1, "maximum": 8},
        "profile": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_flows", "data_memory_mib", "receive_initial_kib", "receive_max_mib", "replay_max_mib"],
      "properties": {
        "max_flows": {"type": "integer", "minimum": 1, "maximum": 65535},
        "data_memory_mib": {"type": "integer", "minimum": 16, "maximum": 4096},
        "receive_initial_kib": {"type": "integer", "minimum": 1},
        "receive_max_mib": {"type": "integer", "minimum": 1},
        "replay_max_mib": {"type": "integer", "minimum": 1}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "retention_seconds"],
      "properties": {
        "enabled": {"const": false},
        "retention_seconds": {"type": "integer", "minimum": 0, "maximum": 300}
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "direction"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "listen": {"type": "string"},
          "remote_route": {"type": "string", "maxLength": 64},
          "direction": {"enum": ["outbound", "inbound"]},
          "traffic_class": {"type": "string"},
          "target": {"type": "string"},
          "allowed_peers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "management": {
      "type": "object", "additionalProperties": false,
      "required": ["unix_socket", "metrics_listen"],
      "properties": {
        "unix_socket": {"type": "string", "minLength": 1},
        "metrics_listen": {"type": "string", "minLength": 3}
      }
    },
    "logging": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "payload"],
      "properties": {
        "level": {"enum": ["debug", "info", "warn", "error"]},
        "payload": {"const": false}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"node": {"properties": {"role": {"const": "dialer"}}}}}, "then": {"required": ["peer"], "not": {"required": ["server"]}}},
    {"if": {"properties": {"node": {"properties": {"role": {"const": "listener"}}}}}, "then": {"required": ["server"], "not": {"required": ["peer"]}}}
  ]
}
