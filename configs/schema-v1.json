{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baft.invalid/schema/config-v1.json",
  "title": "BAFT configuration schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node", "tls", "transport", "limits", "recovery", "routes", "management", "logging"],
  "properties": {
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_file"
      ],
      "oneOf": [
        {"required": ["peer_public_key"]},
        {"required": ["allowed_peer_public_keys"]}
      ],
      "properties": {
        "key_file": {
          "type": "string",
          "minLength": 1
        },
        "peer_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "allowed_peer_public_keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "cover_html_file": {
          "type": "string"
        },
        "record_shaping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "distribution": {
              "enum": [
                "normal",
                "laplace"
              ]
            },
            "mean_bytes": {
              "type": "number",
              "minimum": 0,
              "maximum": 65536
            },
            "stddev_bytes": {
              "type": "number",
              "minimum": 1,
              "maximum": 65536
            },
            "max_padding_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "max_padding_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "jitter_min_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "jitter_max_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        }
      }
    },
    "schema_version": {"const": 1},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "role": {"enum": ["dialer", "listener"]}
      }
    },
    "peer": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "server_name", "allowed_identity"],
      "properties": {
        "address": {"type": "string", "minLength": 3},
        "server_name": {"type": "string", "minLength": 1},
        "allowed_identity": {"type": "string", "minLength": 1}
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["listen", "server_name", "allowed_peer_identities"],
      "properties": {
        "listen": {"type": "string", "minLength": 3},
        "server_name": {"type": "string", "minLength": 1},
        "allowed_peer_identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["min_version", "ca_file", "cert_file", "key_file", "session_tickets"],
      "properties": {
        "min_version": {"const": "1.3"},
        "ca_file": {"type": "string", "minLength": 1},
        "cert_file": {"type": "string", "minLength": 1},
        "key_file": {"type": "string", "minLength": 1},
        "session_tickets": {"const": false}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "h3_enabled", "shards", "profile"],
      "properties": {
        "primary": {"const": "h2"},
        "h3_enabled": {"const": false},
        "shards": {"type": "integer", "minimum": 1, "maximum": 8},
        "profile": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_flows", "data_memory_mib", "receive_initial_kib", "receive_max_mib", "replay_max_mib"],
      "properties": {
        "max_flows": {"type": "integer", "minimum": 1, "maximum": 65535},
        "data_memory_mib": {"type": "integer", "minimum": 16, "maximum": 4096},
        "receive_initial_kib": {"type": "integer", "minimum": 1},
        "receive_max_mib": {"type": "integer", "minimum": 1},
        "replay_max_mib": {"type": "integer", "minimum": 1}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "retention_seconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "retention_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "mode": {"const": "same_process"},
        "durable": {"const": false}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"retention_seconds": {"minimum": 1}}}
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "bcc_url": {"type": "string"},
        "agent_token_env": {"type": "string"},
        "interval_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "route_probe_interval_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
        "spool_path": {"type": "string"},
        "spool_max_pending": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "if": {"required": ["enabled"], "properties": {"enabled": {"const": true}}},
      "then": {"required": ["bcc_url"], "properties": {"bcc_url": {"minLength": 1}}}
    },
    "revocation": {
      "type": "object", "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {"type": "string", "pattern": "^/"}
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "direction"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "listen": {"type": "string"},
          "remote_route": {"type": "string", "maxLength": 64},
          "direction": {"enum": ["outbound", "inbound"]},
          "traffic_class": {"type": "string"},
          "target": {"type": "string"},
          "allowed_peers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "management": {
      "type": "object", "additionalProperties": false,
      "required": ["unix_socket", "metrics_listen"],
      "properties": {
        "unix_socket": {"type": "string", "minLength": 1},
        "metrics_listen": {"type": "string", "minLength": 3}
      }
    },
    "logging": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "payload"],
      "properties": {
        "level": {"enum": ["debug", "info", "warn", "error"]},
        "payload": {"const": false}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"node": {"properties": {"role": {"const": "dialer"}}}}}, "then": {"required": ["peer"], "not": {"required": ["server"]}}},
    {"if": {"properties": {"node": {"properties": {"role": {"const": "listener"}}}}}, "then": {"required": ["server"], "not": {"required": ["peer"]}}},
    {"if": {"required": ["noise"], "properties": {"noise": {"required": ["peer_public_key"]}, "node": {"properties": {"role": {"const": "listener"}}}}}, "then": {"properties": {"server": {"properties": {"allowed_peer_identities": {"maxItems": 1}}}}}},
    {"if": {"required": ["noise"], "properties": {"node": {"properties": {"role": {"const": "dialer"}}}}}, "then": {"properties": {"noise": {"required": ["peer_public_key"]}}}},
    {"if": {"required": ["revocation"]}, "then": {"properties": {"node": {"properties": {"role": {"const": "listener"}}}}}}
  ]
}
